---
import Base from '../layouts/Base.astro'
import Hero, {type Slide} from '../components/Hero.astro'
import type {Socials} from '../components/SocialLinks.astro'
import {sanity, urlFor} from '../lib/sanity'

interface Artwork {
  _id: string
  title: string
  year?: number
  image: {
    alt?: string
    asset: {_ref: string}
    hotspot?: {x: number; y: number}
    crop?: {top: number; bottom: number; left: number; right: number}
  }
  dimensions: {width: number; height: number}
  lqip?: string
  landingFit?: 'auto' | 'fill' | 'whole'
  landingMotion?: 'auto' | 'path' | 'still'
  landingPan?: {x?: number; y?: number}
}

interface LandingPage {
  eyebrow?: string
  name?: string
  slideSeconds?: number
  panSpeed?: number
  transition?: 'fade' | 'dip'
  slides?: Artwork[]
  extras?: Artwork[]
  socials?: Socials
}

const artworkFields = `_id, title, year, image, landingFit, landingMotion, landingPan, "dimensions": image.asset->metadata.dimensions, "lqip": image.asset->metadata.lqip`

const page = await sanity.fetch<LandingPage | null>(`
  *[_id == "landingPage"][0]{
    eyebrow, name, slideSeconds, panSpeed, transition, socials,
    "slides": slides[@->showOnLanding == true && defined(@->image.asset)]->{${artworkFields}},
    "extras": *[_type == "artwork" && showOnLanding == true && defined(image.asset)
      && !(_id in ^.slides[]._ref) && !(_id in path("drafts.**"))] | order(year desc, _createdAt desc){${artworkFields}}
  }
`)

const artworks = [...(page?.slides ?? []), ...(page?.extras ?? [])]

// Steps up to 5K-class screens; the original's own width is always the last option
const widths = [640, 960, 1280, 1600, 2000, 2560, 3200, 3840, 4480, 5120, 6016]

const slides: Slide[] = artworks.map(({image, dimensions, title, lqip, landingFit, landingMotion, landingPan}) => {
  const crop = image.crop ?? {top: 0, bottom: 0, left: 0, right: 0}
  const hotspot = image.hotspot ?? {x: 0.5, y: 0.5}
  // Hotspot and pan points are measured on the uncropped image, so shift them into the cropped frame
  const clamp = (n: number) => Math.min(Math.max(n, 0), 1)
  const inCrop = (p: {x: number; y: number}) => ({
    x: clamp((p.x - crop.left) / (1 - crop.left - crop.right)),
    y: clamp((p.y - crop.top) / (1 - crop.top - crop.bottom)),
  })
  const focus = inCrop(hotspot)
  const posX = focus.x
  const posY = focus.y
  const panEnd =
    landingMotion === 'path' && typeof landingPan?.x === 'number' && typeof landingPan?.y === 'number'
      ? inCrop({x: landingPan.x, y: landingPan.y})
      : undefined
  const width = Math.round(dimensions.width * (1 - crop.left - crop.right))
  const height = Math.round(dimensions.height * (1 - crop.top - crop.bottom))
  const aspect = width / height
  const usable = [...widths.filter((w) => w < width * 0.95), width]
  const src = (w: number) => urlFor(image).width(w).quality(90).auto('format').url()
  return {
    src: src(Math.min(1920, width)),
    srcset: usable.map((w) => `${src(w)} ${w}w`).join(', '),
    // The frame is cover-cropped, so a wide piece on a tall screen needs pixels for the full height
    sizes: `(min-aspect-ratio: ${width}/${height}) 100vw, ${Math.ceil(100 * aspect)}vh`,
    alt: image.alt ?? title,
    width,
    height,
    position: `${(posX * 100).toFixed(1)}% ${(posY * 100).toFixed(1)}%`,
    focus,
    motion: panEnd ? 'path' : landingMotion === 'still' ? 'still' : 'auto',
    panEnd,
    placeholder: lqip,
    backdrop: urlFor(image).width(400).blur(40).quality(60).auto('format').url(),
    fit: landingFit ?? 'auto',
  }
})

const name = page?.name ?? 'Cordelia Moore'
const eyebrow = page?.eyebrow ?? 'Illustrator & Concept Artist'
---

<Base title={`${name} | ${eyebrow}`}>
  {slides[0] && <link slot="head" rel="preload" as="image" imagesrcset={slides[0].srcset} imagesizes={slides[0].sizes} fetchpriority="high" />}
  <Hero
    slides={slides}
    name={name}
    eyebrow={eyebrow}
    seconds={page?.slideSeconds ?? 5}
    panSpeed={page?.panSpeed ?? 28}
    transition={page?.transition ?? 'fade'}
    socials={page?.socials ?? {}}
  />
</Base>
