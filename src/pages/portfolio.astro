---
import Page from '../layouts/Page.astro'
import Gallery from '../components/Gallery.astro'
import {getSite} from '../lib/sanity'
import {getPortfolio} from '../lib/portfolio'

const site = await getSite()
const {intro, pieces} = await getPortfolio()
---

<Page title={`Portfolio | ${site.name}`} site={site} description={`A portfolio of work by ${site.name}, ${site.eyebrow.toLowerCase()}.`}>
  <h1 class="heading">Portfolio</h1>
  {intro && <p class="intro">{intro}</p>}
  <div class="pieces">
    <Gallery pieces={pieces} />
  </div>
</Page>

<style>
  .heading {
    margin: clamp(0.5rem, 2vw, 1.5rem) 0 0;
    text-align: center;
    font-size: clamp(1.1rem, 0.9rem + 1vw, 1.6rem);
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--cocoa);
  }

  .intro {
    max-width: 38rem;
    margin: 0.75rem auto 0;
    text-align: center;
    color: var(--cocoa);
    line-height: 1.6;
  }

  .pieces {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
</style>
