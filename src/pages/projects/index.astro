---
import Page from '../../layouts/Page.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import {getSite} from '../../lib/sanity'
import {getProjects} from '../../lib/projects'

const site = await getSite()
const {intro, projects} = await getProjects()
---

<Page title={`Projects | ${site.name}`} site={site} description={`Projects by ${site.name}, ${site.eyebrow.toLowerCase()}.`}>
  <h1 class="heading">Projects</h1>
  {intro && <p class="intro">{intro}</p>}
  <ul class="grid">
    {
      projects.map((project, i) => (
        <li>
          <ProjectCard project={project} eager={i < 4} />
        </li>
      ))
    }
  </ul>
</Page>

<style>
  .heading {
    margin: clamp(0.5rem, 2vw, 1.5rem) 0 0;
    text-align: center;
    font-size: clamp(1.1rem, 0.9rem + 1vw, 1.6rem);
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--cocoa);
  }

  .intro {
    max-width: 38rem;
    margin: 0.75rem auto 0;
    text-align: center;
    color: var(--cocoa);
    line-height: 1.6;
  }

  .grid {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(9.5rem, 22vw, 17rem), 1fr));
    gap: var(--gutter);
  }
</style>
