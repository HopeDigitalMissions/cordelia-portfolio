---
import {urlFor} from '../lib/sanity'
import type {Piece} from '../lib/projects'

interface Props {
  pieces: Piece[]
}

const {pieces} = Astro.props
const widths = [400, 640, 900, 1200, 1600, 2000, 2600, 3200, 4000]

const items = pieces.map((piece) => {
  const {width, height} = piece.dimensions
  // The gallery always shows the whole piece, so size it from the original asset rather than any crop
  const src = (w: number) => urlFor(piece.image.asset).width(w).quality(90).auto('format').url()
  const usable = widths.filter((w) => w < width * 0.95)
  return {
    ...piece,
    width,
    height,
    src: src(Math.min(1200, width)),
    srcset: [...usable, width].map((w) => `${src(w)} ${w}w`).join(', '),
  }
})
---

<div class="gallery" data-gallery>
  {
    items.map((item, i) => (
      <a
        class="piece"
        href={item.video ?? item.url}
        data-full={item.url}
        data-video={item.video}
        data-width={item.width}
        data-height={item.height}
        data-project-href={item.project && `/projects/${item.project.slug}`}
        data-project-title={item.project?.title}
        aria-label={item.video ? `Play ${item.title}` : `View ${item.title}`}
        style={`aspect-ratio: ${item.width} / ${item.height};`}
      >
        <img
          src={item.src}
          srcset={item.srcset}
          sizes="(min-width: 1700px) 33vw, (min-width: 700px) 50vw, 100vw"
          alt={item.image.alt ?? item.title}
          width={item.width}
          height={item.height}
          loading={i < 4 ? 'eager' : 'lazy'}
          decoding="async"
          style={item.lqip ? `background-image: url(${item.lqip})` : undefined}
        />
        {
          item.video && (
            <span class="play" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
              </svg>
            </span>
          )
        }
      </a>
    ))
  }
</div>

<dialog class="viewer" aria-label="Artwork viewer">
  <div class="viewer-stage" data-stage></div>
  <button class="viewer-button viewer-close" type="button" aria-label="Close" data-close>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none" />
    </svg>
  </button>
  <button class="viewer-button viewer-prev" type="button" aria-label="Previous piece" data-prev>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
  </button>
  <button class="viewer-button viewer-next" type="button" aria-label="Next piece" data-next>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
  </button>
  <a class="viewer-project" href="/projects" hidden data-project>
    <span>View project: <span data-project-title></span></span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
  </a>
</dialog>

<style>
  /* Without the layout script: simple columns, nothing taller than the window */
  .gallery {
    columns: 2 300px;
    column-gap: var(--gutter);
  }

  .piece {
    position: relative;
    display: block;
    break-inside: avoid;
    margin-bottom: var(--gutter);
    max-height: calc(100vh - 2 * var(--gutter));
    cursor: zoom-in;
  }

  .piece img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background-size: cover;
  }

  /* With the layout script: pieces are placed in even rows */
  .gallery.is-laid-out {
    columns: auto;
    position: relative;
  }

  .gallery.is-laid-out .piece {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    max-height: none;
    aspect-ratio: auto;
  }

  .piece:focus-visible {
    outline: 3px solid var(--cocoa);
    outline-offset: 3px;
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin: -2rem 0 0 -2rem;
    border-radius: 50%;
    background: var(--paper);
    color: var(--cocoa);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.25);
    transition: transform 150ms ease-out;
  }

  .play svg {
    width: 1.75rem;
    margin-left: 0.2rem;
  }

  .piece:hover .play {
    transform: scale(1.08);
  }

  .viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .viewer::backdrop {
    background: rgb(255 207 51 / 0.9);
  }

  .viewer-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    touch-action: none;
  }

  .viewer-stage :global(img),
  .viewer-stage :global(video) {
    display: block;
    max-width: none;
    box-shadow: 0 4px 28px rgb(0 0 0 / 0.22);
    user-select: none;
    -webkit-user-drag: none;
  }

  .viewer-stage :global(img.is-zoomable) {
    cursor: zoom-in;
  }

  .viewer-stage.is-zoomed {
    display: block;
  }

  .viewer-stage.is-zoomed :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    cursor: zoom-out;
    box-shadow: none;
  }

  .viewer-button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    color: var(--cocoa);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
    cursor: pointer;
    transition:
      background-color 150ms,
      opacity 150ms;
  }

  .viewer-button svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .viewer-button:hover,
  .viewer-button:focus-visible {
    background: var(--sun-deep);
  }

  .viewer-button:focus-visible {
    outline: 2px solid var(--cocoa);
    outline-offset: 2px;
  }

  .viewer-close {
    top: clamp(10px, 2vmin, 20px);
    right: clamp(10px, 2vmin, 20px);
  }

  .viewer-prev,
  .viewer-next {
    top: 50%;
    margin-top: -1.375rem;
  }

  .viewer-prev {
    left: clamp(8px, 1.5vmin, 18px);
  }

  .viewer-next {
    right: clamp(8px, 1.5vmin, 18px);
  }

  .viewer-button[hidden] {
    display: none;
  }

  @media (max-width: 600px) {
    .viewer-prev,
    .viewer-next {
      width: 2.25rem;
      height: 2.25rem;
      margin-top: -1.125rem;
      opacity: 0.85;
    }
  }

  /* Out of the way while panning around a zoomed piece */
  .viewer:has(.is-zoomed) .viewer-prev,
  .viewer:has(.is-zoomed) .viewer-next {
    opacity: 0;
    pointer-events: none;
  }

  /* On the Portfolio page: a way through to the rest of the piece's project */
  .viewer-project {
    position: absolute;
    left: 50%;
    bottom: clamp(10px, 2vmin, 20px);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    max-width: calc(100% - 2 * clamp(10px, 2vmin, 20px));
    padding: 0.7rem 0.85rem 0.7rem 1.15rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--cocoa);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms,
      opacity 150ms;
  }

  .viewer-project > span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .viewer-project svg {
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  .viewer-project:hover,
  .viewer-project:focus-visible {
    background: var(--sun-deep);
  }

  .viewer-project:focus-visible {
    outline: 2px solid var(--cocoa);
    outline-offset: 2px;
  }

  .viewer-project[hidden] {
    display: none;
  }

  .viewer:has(.is-zoomed) .viewer-project {
    opacity: 0;
    pointer-events: none;
  }

  :global(html.viewer-open) {
    overflow: hidden;
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]')
  const dialog = document.querySelector<HTMLDialogElement>('.viewer')

  if (gallery && dialog) {
    const pieces = [...gallery.querySelectorAll<HTMLAnchorElement>('.piece')]

    // Even rows: every piece in a row shares one height and the row spans the full width, so top
    // and bottom edges line up. Row breaks are chosen to keep heights close to a target, and no
    // row is taller than the window.
    function layout() {
      const width = gallery!.clientWidth
      const gap = parseFloat(getComputedStyle(gallery!).columnGap) || 16
      const maxHeight = window.innerHeight - 2 * gap
      const target = Math.min(maxHeight, Math.max(240, Math.min(window.innerHeight * 0.55, width * 0.38)))
      const aspects = pieces.map((piece) => Number(piece.dataset.width) / Number(piece.dataset.height))
      const n = aspects.length

      const rowHeight = (from: number, to: number) => {
        let sum = 0
        for (let i = from; i < to; i++) sum += aspects[i]
        return (width - gap * (to - from - 1)) / sum
      }
      const cost = (from: number, to: number) => {
        const h = rowHeight(from, to)
        const count = to - from
        if (to === n && h > target) return 0 // a short last row just stays at the target height
        if (h > maxHeight) return 1e12 + h
        return count * (h - target) ** 2
      }

      // Best place to break each row (small enough to try every option)
      const best = new Array(n + 1).fill(Infinity)
      const breakAt = new Array(n + 1).fill(0)
      best[0] = 0
      for (let to = 1; to <= n; to++) {
        for (let from = Math.max(0, to - 8); from < to; from++) {
          const total = best[from] + cost(from, to)
          if (total < best[to]) {
            best[to] = total
            breakAt[to] = from
          }
        }
      }
      const rows: [number, number][] = []
      for (let to = n; to > 0; to = breakAt[to]) rows.unshift([breakAt[to], to])

      let top = 0
      for (const [from, to] of rows) {
        let h = rowHeight(from, to)
        if (h > maxHeight || (to === n && h > target)) h = Math.min(maxHeight, target)
        const rowWidth = aspects.slice(from, to).reduce((sum, a) => sum + a * h, 0) + gap * (to - from - 1)
        let x = Math.max(0, (width - rowWidth) / 2)
        for (let i = from; i < to; i++) {
          const w = aspects[i] * h
          const piece = pieces[i]
          piece.style.width = `${w}px`
          piece.style.height = `${h}px`
          piece.style.transform = `translate(${x}px, ${top}px)`
          piece.querySelector('img')!.sizes = `${Math.ceil(w)}px`
          x += w + gap
        }
        top += h + gap
      }

      gallery!.style.height = `${Math.max(0, top - gap)}px`
      gallery!.classList.add('is-laid-out')
    }

    layout()
    new ResizeObserver(layout).observe(gallery)
    window.addEventListener('resize', layout)

    // Full-screen viewer
    const stage = dialog.querySelector<HTMLElement>('[data-stage]')!
    const prevButton = dialog.querySelector<HTMLButtonElement>('[data-prev]')!
    const nextButton = dialog.querySelector<HTMLButtonElement>('[data-next]')!
    prevButton.hidden = nextButton.hidden = pieces.length < 2
    const projectLink = dialog.querySelector<HTMLAnchorElement>('[data-project]')!

    // Only pieces shown outside their project carry one
    function showProject(piece: HTMLElement) {
      const href = piece.dataset.projectHref
      projectLink.hidden = !href
      if (!href) return
      projectLink.href = href
      projectLink.querySelector('[data-project-title]')!.textContent = piece.dataset.projectTitle ?? ''
    }

    let index = 0
    let media: HTMLImageElement | HTMLVideoElement | null = null
    let zoomed = false
    let loadedWidth = 0
    let pan = {x: 0, y: 0}
    // Zoom level as a share of the original's pixels: 1 is full resolution
    let scale = 1

    const natural = (piece: HTMLElement) => ({w: Number(piece.dataset.width), h: Number(piece.dataset.height)})
    const sized = (url: string, w: number) => `${url}?w=${w}&q=92&auto=format`

    function fit() {
      const {w, h} = natural(pieces[index])
      const pad = Math.max(16, Math.min(56, Math.min(innerWidth, innerHeight) * 0.05))
      const scale = Math.min(1, (innerWidth - 2 * pad) / w, (innerHeight - 2 * pad) / h)
      return {w: Math.round(w * scale), h: Math.round(h * scale)}
    }

    // Ask the image CDN for just enough pixels for the size on screen, stepping up as the window grows
    function sharpen(img: HTMLImageElement, displayWidth: number) {
      const piece = pieces[index]
      const full = natural(piece).w
      let want = Math.min(full, Math.ceil((displayWidth * devicePixelRatio) / 400) * 400)
      // Close to the original anyway: just use the original
      if (want > full * 0.8) want = full
      if (want <= loadedWidth) return
      loadedWidth = want
      const next = new Image()
      next.src = want === full ? piece.dataset.full! : sized(piece.dataset.full!, want)
      next.decode().then(
        () => {
          if (media === img) img.src = next.src
        },
        () => {},
      )
    }

    function place() {
      if (!media) return
      const piece = pieces[index]
      if (zoomed && media instanceof HTMLImageElement) {
        const {w, h} = natural(piece)
        media.style.width = `${w * scale}px`
        media.style.height = `${h * scale}px`
        clampPan()
        sharpen(media, w * scale)
        return
      }
      const size = fit()
      media.style.width = `${size.w}px`
      media.style.height = `${size.h}px`
      media.style.transform = ''
      if (media instanceof HTMLImageElement) {
        media.classList.toggle('is-zoomable', natural(piece).w > size.w * 1.4)
        sharpen(media, size.w)
      }
    }

    function clampPan() {
      if (!media) return
      const {w, h} = natural(pieces[index])
      const limit = (offset: number, size: number, view: number) =>
        size <= view ? (view - size) / 2 : Math.min(0, Math.max(view - size, offset))
      pan = {x: limit(pan.x, w * scale, innerWidth), y: limit(pan.y, h * scale, innerHeight)}
      media.style.transform = `translate(${pan.x}px, ${pan.y}px)`
    }

    function show(i: number) {
      index = (i + pieces.length) % pieces.length
      const piece = pieces[index]
      const thumb = piece.querySelector('img')!
      zoomed = false
      scale = 1
      loadedWidth = 0
      stage.classList.remove('is-zoomed')
      stage.replaceChildren()
      showProject(piece)

      if (piece.dataset.video) {
        const video = document.createElement('video')
        video.src = piece.dataset.video
        video.poster = thumb.currentSrc || thumb.src
        video.controls = true
        video.autoplay = true
        video.playsInline = true
        media = video
      } else {
        const img = document.createElement('img')
        img.alt = thumb.alt
        img.draggable = false
        // Start from the gallery's copy so something shows at once, then sharpen
        img.src = thumb.currentSrc || thumb.src
        media = img
      }
      stage.append(media)
      place()

      // Warm up the neighbours at screen size
      for (const n of [index + 1, index - 1]) {
        const neighbour = pieces[(n + pieces.length) % pieces.length]
        if (neighbour.dataset.video) continue
        const pre = new Image()
        pre.src = sized(neighbour.dataset.full!, Math.min(natural(neighbour).w, Math.ceil((fit().w * devicePixelRatio) / 400) * 400))
      }
    }

    // A mouse pans by where it sits in the window, so the whole piece is reachable without dragging
    const glide = (clientX: number, clientY: number) => {
      const {w, h} = natural(pieces[index])
      return {x: (-(w - innerWidth) * clientX) / innerWidth, y: (-(h - innerHeight) * clientY) / innerHeight}
    }

    function zoomAt(clientX: number, clientY: number, pointerType: string) {
      if (!(media instanceof HTMLImageElement) || !media.classList.contains('is-zoomable')) return
      const img = media
      const rect = img.getBoundingClientRect()
      const {w, h} = natural(pieces[index])
      // On touch, keep the tapped spot under the finger as the piece grows to full size
      pan =
        pointerType === 'mouse'
          ? glide(clientX, clientY)
          : {
              x: clientX - ((clientX - rect.left) / rect.width) * w,
              y: clientY - ((clientY - rect.top) / rect.height) * h,
            }
      scale = 1
      zoomed = true
      stage.classList.add('is-zoomed')
      place()
      const full = new Image()
      full.src = pieces[index].dataset.full!
      full.decode().then(
        () => {
          if (media === img && zoomed) img.src = full.src
        },
        () => {},
      )
    }

    function unzoom() {
      zoomed = false
      scale = 1
      stage.classList.remove('is-zoomed')
      place()
    }

    // Touch: pinch to zoom anywhere between fitting the screen and full resolution,
    // keeping the spot between the fingers in place. Double-tap toggles a closer look.
    function zoomTo(nextScale: number, clientX: number, clientY: number) {
      if (!(media instanceof HTMLImageElement)) return
      const {w} = natural(pieces[index])
      const fitScale = fit().w / w
      const rect = media.getBoundingClientRect()
      const fx = (clientX - rect.left) / rect.width
      const fy = (clientY - rect.top) / rect.height
      scale = Math.min(Math.max(nextScale, fitScale), Math.max(1, fitScale))
      if (scale <= fitScale * 1.02) {
        unzoom()
        return
      }
      const {h} = natural(pieces[index])
      pan = {x: clientX - fx * w * scale, y: clientY - fy * h * scale}
      zoomed = true
      stage.classList.add('is-zoomed')
      place()
    }

    const touches = new Map<number, {x: number; y: number}>()
    let pinch: {distance: number; scale: number} | null = null
    let lastTap = 0

    const currentScale = () => (zoomed ? scale : fit().w / natural(pieces[index]).w)

    // One set of pointer handlers covers mouse, pen and touch
    let down: {x: number; y: number; panX: number; panY: number; moved: boolean; target: EventTarget | null} | null = null

    stage.addEventListener('pointerdown', (event) => {
      // Leave the video's own controls alone
      if (event.target instanceof HTMLVideoElement) return
      if (event.pointerType === 'touch') {
        touches.set(event.pointerId, {x: event.clientX, y: event.clientY})
        if (touches.size === 2) {
          const [a, b] = [...touches.values()]
          pinch = {distance: Math.hypot(a.x - b.x, a.y - b.y), scale: currentScale()}
          down = null
          stage.setPointerCapture(event.pointerId)
          return
        }
      }
      down = {x: event.clientX, y: event.clientY, panX: pan.x, panY: pan.y, moved: false, target: event.target}
      stage.setPointerCapture(event.pointerId)
    })

    stage.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch' && touches.has(event.pointerId)) {
        touches.set(event.pointerId, {x: event.clientX, y: event.clientY})
        if (pinch && touches.size >= 2) {
          const [a, b] = [...touches.values()]
          zoomTo(pinch.scale * (Math.hypot(a.x - b.x, a.y - b.y) / pinch.distance), (a.x + b.x) / 2, (a.y + b.y) / 2)
          return
        }
      }
      if (zoomed && media) {
        if (event.pointerType === 'mouse' && !down) {
          pan = glide(event.clientX, event.clientY)
          clampPan()
        } else if (down) {
          pan = {x: down.panX + event.clientX - down.x, y: down.panY + event.clientY - down.y}
          clampPan()
        }
      }
      if (down && Math.hypot(event.clientX - down.x, event.clientY - down.y) > 6) down.moved = true
    })

    const release = (event: PointerEvent) => {
      touches.delete(event.pointerId)
      if (touches.size < 2) pinch = null
    }

    stage.addEventListener('pointerup', (event) => {
      const wasPinching = pinch !== null || touches.size > 1
      release(event)
      if (wasPinching) return
      if (!down) return
      const start = down
      down = null
      const dx = event.clientX - start.x
      const dy = event.clientY - start.y

      if (!start.moved) {
        if (event.pointerType === 'touch' && media instanceof HTMLImageElement) {
          // Phones: double-tap to look closer or back out; a single tap on the yellow closes
          const now = performance.now()
          if (now - lastTap < 320) {
            lastTap = 0
            if (zoomed) unzoom()
            else zoomTo(currentScale() * 2.5, event.clientX, event.clientY)
          } else {
            lastTap = now
            if (start.target === stage && !zoomed) dialog!.close()
          }
          return
        }
        if (start.target === media && media instanceof HTMLImageElement) {
          if (zoomed) unzoom()
          else zoomAt(event.clientX, event.clientY, event.pointerType)
        } else if (start.target === stage) {
          dialog!.close()
        }
        return
      }
      // Swipe between pieces when not zoomed
      if (!zoomed && Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1))
    })

    stage.addEventListener('pointercancel', (event) => {
      release(event)
      down = null
    })

    prevButton.addEventListener('click', () => show(index - 1))
    nextButton.addEventListener('click', () => show(index + 1))
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close())

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') show(index + 1)
      else if (event.key === 'ArrowLeft') show(index - 1)
    })

    dialog.addEventListener('close', () => {
      if (media instanceof HTMLVideoElement) media.pause()
      stage.replaceChildren()
      media = null
      document.documentElement.classList.remove('viewer-open')
    })

    window.addEventListener('resize', () => {
      if (dialog.open) place()
    })

    pieces.forEach((piece, i) => {
      piece.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey) return
        event.preventDefault()
        document.documentElement.classList.add('viewer-open')
        dialog.showModal()
        show(i)
      })
    })
  }
</script>
