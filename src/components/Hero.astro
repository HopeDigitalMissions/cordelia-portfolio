---
import NameMark from '../assets/name-mark.svg'
import SocialLinks, {type Socials} from './SocialLinks.astro'
import {nav} from '../lib/nav'

export interface Slide {
  src: string
  srcset: string
  sizes: string
  alt: string
  width: number
  height: number
  position: string
  placeholder?: string
  backdrop: string
  fit: 'auto' | 'fill' | 'whole'
  /** Hotspot as fractions of the (cropped) image */
  focus: {x: number; y: number}
  motion: 'auto' | 'path' | 'still'
  panEnd?: {x: number; y: number}
}

interface Props {
  slides: Slide[]
  name: string
  eyebrow: string
  seconds: number
  panSpeed: number
  transition: 'fade' | 'dip'
  socials: Socials
}

const {slides, name, eyebrow, seconds, panSpeed, transition, socials} = Astro.props
---

<main class="hero" data-seconds={seconds} data-pan-speed={panSpeed} data-transition={transition}>
  <div class="stage">
    {
      slides.map((slide, i) => (
        <figure
          class:list={['slide', {'is-active': i === 0}]}
          data-fit={slide.fit}
          data-focus={`${slide.focus.x} ${slide.focus.y}`}
          data-motion={slide.motion}
          data-pan-end={slide.panEnd ? `${slide.panEnd.x} ${slide.panEnd.y}` : undefined}
          data-aspect={slide.width / slide.height}
          data-backdrop={slide.backdrop}
          style={`--position: ${slide.position};${i === 0 && slide.placeholder ? ` --placeholder: url(${slide.placeholder});` : ''}`}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <img
            src={i === 0 ? slide.src : undefined}
            srcset={i === 0 ? slide.srcset : undefined}
            data-src={slide.src}
            data-srcset={slide.srcset}
            sizes={slide.sizes}
            alt={slide.alt}
            width={slide.width}
            height={slide.height}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
          />
        </figure>
      ))
    }
    <div class="dip" aria-hidden="true"></div>
  </div>

  <div class="card">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="name">
      <span class="visually-hidden">{name}</span>
      <NameMark class="name-mark" aria-hidden="true" />
    </h1>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <SocialLinks socials={socials} class="hero-socials" />
</main>

<style>
  .hero {
    --frame: clamp(12px, 2.2vw, 30px);
    position: relative;
    height: 100vh;
    height: 100dvh;
    padding: var(--frame);
    background: var(--sun);
    display: grid;
    grid-template:
      '.' 1fr
      'card' auto
      'socials' 1fr
      / minmax(0, 1fr);
    justify-items: center;
    overflow: hidden;
  }

  .hero :global(.hero-socials) {
    grid-area: socials;
    align-self: end;
    position: relative;
    z-index: 4;
    margin: 0.75rem 0 clamp(0.75rem, 2.5vh, 1.5rem);
  }

  .stage {
    position: absolute;
    inset: var(--frame);
    overflow: hidden;
    background: var(--paper);
  }

  .slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    z-index: 0;
    background: center / cover no-repeat;
    background-image: var(--backdrop, none);
  }

  .slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position);
    background: var(--placeholder, none) var(--position) / cover no-repeat;
  }

  /* A tall piece on a wide screen: show all of it over a blur of itself */
  .slide.is-whole img {
    object-fit: contain;
    object-position: 50% 50%;
    background: none;
    filter: drop-shadow(0 0 24px rgb(0 0 0 / 0.25));
  }

  /* Size and drift are set by the script: the piece is drawn at its full shape and slid along its path */
  .slide.is-panning img {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    object-fit: fill;
    background: none;
    will-change: transform;
  }

  .slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .slide.is-entering {
    z-index: 2;
    animation: fade-in var(--fade, 450ms) ease-out forwards;
  }

  .dip {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--paper);
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease-in;
  }

  .dip.is-on {
    opacity: 1;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .card {
    grid-area: card;
    position: relative;
    z-index: 4;
    width: min(760px, 100% - 2rem);
    padding: clamp(1.75rem, 4.5vw, 3.25rem) clamp(1.25rem, 4vw, 3rem);
    background: var(--paper);
    text-align: center;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
  }

  .eyebrow {
    margin: 0 0 0.9em;
    font-size: clamp(0.72rem, 0.6rem + 0.55vw, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--honey);
  }

  .name {
    margin: 0;
    color: var(--cocoa);
  }

  /* Her name is lettered artwork outlined from the Magic Story font (scripts/name-mark.py) */
  .name-mark {
    display: block;
    width: clamp(220px, 23vw, 380px);
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  nav ul {
    list-style: none;
    margin: clamp(1.5rem, 3.5vw, 2.5rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem clamp(1rem, 3vw, 2.25rem);
  }

  nav a {
    display: inline-block;
    padding: 0.6em 0.2em;
    font-size: clamp(0.8rem, 0.7rem + 0.4vw, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cocoa-soft);
    background: linear-gradient(var(--sun), var(--sun)) no-repeat 50% calc(100% - 0.35em) / 0 2px;
    transition:
      color 150ms,
      background-size 200ms ease-out;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--cocoa);
    background-size: calc(100% - 0.2em) 2px;
  }

  nav a:focus-visible {
    outline: 2px solid var(--sun-deep);
    outline-offset: 2px;
  }

  /* Phones held upright: the card moves to the bottom so the art keeps the top of the screen */
  @media (max-aspect-ratio: 4/5) {
    .hero {
      grid-template:
        '.' 1fr
        'socials' auto
        'card' auto
        / minmax(0, 1fr);
      padding-bottom: calc(var(--frame) + 0.75rem + env(safe-area-inset-bottom));
    }

    .hero :global(.hero-socials) {
      margin: 0 0 0.75rem;
    }

    .slide.is-whole img {
      object-position: 50% 30%;
    }
  }

  /* Phones turned sideways: keep the card compact so the art still shows */
  @media (max-height: 520px) and (min-aspect-ratio: 1/1) {
    .card {
      width: min(560px, 100% - 2rem);
      padding: 1rem 1.5rem 0.5rem;
    }

    .eyebrow {
      margin-bottom: 0.5em;
    }

    .name-mark {
      width: 44vh;
      min-width: 0;
    }

    nav ul {
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .card {
      width: calc(100% - 1.5rem);
      padding: 1.5rem 1rem 1rem;
    }

    .eyebrow {
      font-size: 0.68rem;
      letter-spacing: 0.2em;
    }

    .name-mark {
      width: 58%;
      min-width: 0;
    }

    nav ul {
      margin-top: 0.9rem;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero')!
  const stage = hero.querySelector<HTMLElement>('.stage')!
  const slides = [...hero.querySelectorAll<HTMLElement>('.slide')]
  const dip = hero.querySelector<HTMLElement>('.dip')!
  const seconds = Number(hero.dataset.seconds) || 5
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
  const transition = reducedMotion ? 'fade' : hero.dataset.transition

  // A tall piece on a wide screen is shown whole over a blur of itself when cropping would leave
  // less than this share of it visible. Everything else fills the screen.
  const MIN_VISIBLE = 0.55
  // Automatic motion: on upright screens a wide piece starts at its hotspot and drifts toward the
  // side with more art. A path set in Sanity runs from its start point to the hotspot instead, in any
  // direction, on any screen where the piece is cropped. Every piece moves at the same speed; a
  // piece with a long path stays up until it arrives.
  const PAN_SPEED = Number(hero.dataset.panSpeed) || 28 // CSS pixels per second
  const MAX_PATH_ZOOM = 1.3

  type Pan = {from: [number, number]; to: [number, number]; duration: number; animation?: Animation}
  const pans = new Map<HTMLElement, Pan>()
  const point = (value?: string) => (value ? (value.split(' ').map(Number) as [number, number]) : undefined)

  function fit() {
    const stageWidth = stage.clientWidth
    const stageHeight = stage.clientHeight
    const screen = stageWidth / stageHeight
    for (const slide of slides) {
      const img = slide.querySelector('img')!
      const aspect = Number(slide.dataset.aspect)
      const visible = Math.min(screen / aspect, aspect / screen)
      const mode = slide.dataset.fit
      const whole = mode === 'whole' || (mode === 'auto' && aspect < 1 && screen >= 1 && visible < MIN_VISIBLE)
      slide.classList.toggle('is-whole', whole)
      if (whole && !slide.style.getPropertyValue('--backdrop')) {
        slide.style.setProperty('--backdrop', `url(${slide.dataset.backdrop})`)
      }

      pans.get(slide)?.animation?.cancel()
      pans.delete(slide)

      const cover = Math.max(stageWidth, stageHeight * aspect)
      let drawnWidth = whole ? Math.min(stageWidth, stageHeight * aspect) : cover
      const focus = point(slide.dataset.focus) ?? [0.5, 0.5]
      const end = point(slide.dataset.panEnd)
      let target: [number, number] | undefined
      let path = false

      if (!whole && !reducedMotion) {
        if (slide.dataset.motion === 'path' && end) {
          // Zoom in a little when the path runs along the side that has no spare room, so it can move that way
          const spareX = cover - stageWidth > 16
          const across = spareX ? Math.abs(end[1] - focus[1]) : Math.abs(end[0] - focus[0])
          drawnWidth = cover * (across > 0.03 ? Math.min(MAX_PATH_ZOOM, 1 + across * 0.8) : 1)
          target = end
          path = true
        } else if (slide.dataset.motion === 'auto' && screen < 1 && cover - stageWidth > 16) {
          // Toward the side with more of the piece left to see
          const from = Math.min(0, Math.max(stageWidth - cover, stageWidth / 2 - focus[0] * cover))
          target = [-from > cover - stageWidth + from ? 0 : 1, focus[1]]
        }
      }

      img.sizes = `${Math.ceil(drawnWidth)}px`

      if (target) {
        const drawnHeight = drawnWidth / aspect
        // Offset that centers a point of the piece on screen, without showing past its edges
        const offset = ([x, y]: [number, number]): [number, number] => [
          Math.min(0, Math.max(stageWidth - drawnWidth, stageWidth / 2 - x * drawnWidth)),
          Math.min(0, Math.max(stageHeight - drawnHeight, stageHeight / 2 - y * drawnHeight)),
        ]
        // A path from Sanity starts at the point she clicked and comes to rest on the hotspot
        const from = path ? offset(target) : offset(focus)
        let to = path ? offset(focus) : offset(target)
        let distance = Math.hypot(to[0] - from[0], to[1] - from[1])
        let duration: number
        if (path) {
          duration = (distance / PAN_SPEED) * 1000
        } else {
          const travel = Math.min(distance, PAN_SPEED * (seconds + 1.5))
          to = [from[0] + ((to[0] - from[0]) * travel) / (distance || 1), from[1]]
          distance = travel
          duration = (travel / PAN_SPEED) * 1000
        }
        if (distance > 8) {
          slide.classList.add('is-panning')
          img.style.width = `${drawnWidth}px`
          img.style.height = `${drawnHeight}px`
          img.style.transform = `translate(${from[0]}px, ${from[1]}px)`
          pans.set(slide, {from, to, duration})
          continue
        }
      }
      slide.classList.remove('is-panning')
      img.style.width = ''
      img.style.height = ''
      img.style.transform = ''
    }
    startPan(slides[current])
  }

  function startPan(slide: HTMLElement) {
    const pan = pans.get(slide)
    if (!pan) return
    pan.animation?.cancel()
    pan.animation = slide.querySelector('img')!.animate(
      [
        {transform: `translate(${pan.from[0]}px, ${pan.from[1]}px)`},
        {transform: `translate(${pan.to[0]}px, ${pan.to[1]}px)`},
      ],
      {duration: pan.duration, easing: 'ease-in-out', fill: 'forwards'},
    )
  }

  const stopPan = (slide: HTMLElement) => pans.get(slide)?.animation?.cancel()

  let current = 0
  let timer: number | undefined

  fit()
  // Phone toolbars nudge the height while scrolling; only refit for real size changes
  let fitted = {w: stage.clientWidth, h: stage.clientHeight}
  new ResizeObserver(() => {
    const w = stage.clientWidth
    const h = stage.clientHeight
    if (Math.abs(w - fitted.w) < 1 && Math.abs(h - fitted.h) < 80) return
    fitted = {w, h}
    fit()
  }).observe(stage)

  const load = (slide: HTMLElement) => {
    const img = slide.querySelector('img')!
    if (!img.srcset && img.dataset.srcset) {
      img.srcset = img.dataset.srcset
      img.src = img.dataset.src!
    }
    return img.decode().catch(() => {})
  }

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))

  async function show(next: number) {
    const from = slides[current]
    const to = slides[next]
    await load(to)

    if (transition === 'dip') {
      dip.classList.add('is-on')
      await wait(170)
      from.classList.remove('is-active')
      to.classList.add('is-active')
      startPan(to)
      stopPan(from)
      dip.classList.remove('is-on')
    } else {
      startPan(to)
      to.classList.add('is-active', 'is-entering')
      await new Promise((resolve) => to.addEventListener('animationend', resolve, {once: true}))
      to.classList.remove('is-entering')
      from.classList.remove('is-active')
      stopPan(from)
    }

    current = next
    // Warm up the one after this so it is ready when its turn comes
    load(slides[(current + 1) % slides.length])
  }

  // How long a piece stays up: the usual time, or long enough to finish its path
  function holdFor(slide: HTMLElement) {
    const pan = pans.get(slide)
    const path = slide.dataset.motion === 'path' && pan ? pan.duration + 600 : 0
    return Math.max(seconds * 1000, path)
  }

  function schedule() {
    clearTimeout(timer)
    timer = window.setTimeout(async () => {
      await show((current + 1) % slides.length)
      schedule()
    }, holdFor(slides[current]))
  }

  if (slides.length > 1) {
    load(slides[1])
    schedule()
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) clearTimeout(timer)
      else schedule()
    })
  }
</script>
