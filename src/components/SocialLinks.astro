---
export interface Socials {
  instagram?: string
  cara?: string
  linkedin?: string
}

interface Props {
  socials: Socials
  class?: string
}

const {socials, class: className} = Astro.props

// Instagram and LinkedIn glyphs from Bootstrap Icons (MIT); Cara's is the C from its wordmark.
// Each viewBox is square so the glyphs scale evenly.
const icons = {
  instagram: {
    label: 'Instagram',
    viewBox: '0 0 16 16',
    d: 'M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334',
  },
  cara: {
    label: 'Cara',
    viewBox: '-0.6 0 28 28',
    d: 'M25.376 9.984h-5.599a5.477 5.477 0 0 0-.626-1.93 4.912 4.912 0 0 0-1.215-1.457 5.345 5.345 0 0 0-1.713-.92 6.552 6.552 0 0 0-2.084-.32c-1.355 0-2.535.336-3.541 1.01-1.006.664-1.786 1.636-2.34 2.914-.553 1.27-.83 2.813-.83 4.628 0 1.867.277 3.435.83 4.705.563 1.27 1.347 2.228 2.353 2.876 1.005.648 2.169.972 3.49.972.741 0 1.427-.098 2.058-.294a5.409 5.409 0 0 0 1.7-.857 4.934 4.934 0 0 0 1.228-1.393 5.43 5.43 0 0 0 .69-1.867l5.6.026a10.131 10.131 0 0 1-1.087 3.477 10.452 10.452 0 0 1-2.314 2.979c-.963.869-2.114 1.56-3.452 2.07-1.33.503-2.834.755-4.513.755-2.335 0-4.423-.528-6.264-1.585-1.832-1.057-3.281-2.587-4.346-4.59-1.057-2.003-1.586-4.427-1.586-7.274 0-2.855.537-5.284 1.611-7.287C4.5 4.62 5.957 3.094 7.798 2.045 9.64.99 11.71.46 14.011.46c1.517 0 2.924.213 4.22.64a10.697 10.697 0 0 1 3.464 1.866 9.6 9.6 0 0 1 2.454 2.979c.64 1.176 1.048 2.522 1.227 4.04Z',
  },
  linkedin: {
    label: 'LinkedIn',
    viewBox: '0 0 16 16',
    d: 'M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z',
  },
} as const

const links = (Object.keys(icons) as (keyof typeof icons)[])
  .filter((key) => socials[key])
  .map((key) => {
    // Fit each glyph into an 18-unit square in the middle of a 40-unit circle
    const [minX, minY, size] = icons[key].viewBox.split(' ').map(Number)
    return {
      ...icons[key],
      key,
      href: socials[key]!,
      transform: `translate(11 11) scale(${18 / size}) translate(${-minX} ${-minY})`,
    }
  })
---

{
  links.length > 0 && (
    <ul class:list={['socials', className]} aria-label="Social media">
      {links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener me" aria-label={link.label} title={link.label}>
            <svg viewBox="0 0 40 40" aria-hidden="true">
              <mask id={`social-cutout-${link.key}`}>
                <rect width="40" height="40" fill="#fff" />
                <path d={link.d} transform={link.transform} fill="#000" />
              </mask>
              <circle cx="20" cy="20" r="20" fill="currentColor" mask={`url(#social-cutout-${link.key})`} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }

  /* Brown discs with the logo cut out, so the card shows through */
  a {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: var(--cocoa);
    transition:
      color 150ms,
      transform 150ms ease-out;
  }

  a:hover,
  a:focus-visible {
    color: var(--honey);
    transform: translateY(-2px);
  }

  a:focus-visible {
    outline: 2px solid var(--sun-deep);
    outline-offset: 3px;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 480px) {
    a {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
